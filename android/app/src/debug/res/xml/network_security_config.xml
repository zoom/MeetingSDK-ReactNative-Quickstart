<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: Meeting SDK can merge a restrictive networkSecurityConfig /
    usesCleartextTraffic=false, which blocks HTTP to Metro. This file restores
    cleartext for local dev; release builds are unaffected. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
